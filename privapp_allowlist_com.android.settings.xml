<!-- Privileged permissions Project Catalyxx's Settings asks for on top of AOSP's. AOSP's own
     list is frameworks/base/data/etc/com.android.settings.xml; Soong installs this one beside
     it as Settings.xml, and the system merges the two. -->
<permissions>
    <privapp-permissions package="com.android.settings">
        <!-- The wallpaper on About phone and the homepage device card -->
        <permission name="android.permission.READ_WALLPAPER_INTERNAL" />
    </privapp-permissions>
</permissions>
