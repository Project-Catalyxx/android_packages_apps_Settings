     The top of an element's page on the periodic Settings home, under the page's title: the
     element's badge with its number and symbol, then its live value.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="4dp"
    android:paddingBottom="16dp"
    android:importantForAccessibility="noHideDescendants">

    <FrameLayout
        android:id="@+id/periodic_header_badge"
        android:layout_width="@dimen/periodic_header_badge_size"
        android:layout_height="@dimen/periodic_header_badge_size">

        <TextView
            android:id="@+id/periodic_header_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/periodic_header_symbol"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="6dp"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </FrameLayout>

    <TextView
        android:id="@+id/periodic_header_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
