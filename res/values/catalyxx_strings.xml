<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- About phone cards and the homepage device card -->

    <!-- Catalyxx version and release codename, e.g. "Catalyxx 17.0 Chlorine" -->
    <string name="catalyxx_about_version" translatable="false">Catalyxx <xliff:g id="version" example="17.0">%1$s</xliff:g> <xliff:g id="codename" example="Chlorine">%2$s</xliff:g></string>
    <!-- Build type next to the version: an official build -->
    <string name="catalyxx_about_official">Official</string>
    <!-- Build type next to the version: a build that isn't official -->
    <string name="catalyxx_about_unofficial">Unofficial</string>

    <!-- Specs card: label of the chip, e.g. "Snapdragon 8 Gen 2" -->
    <string name="catalyxx_about_processor">Processor</string>
    <!-- Specs card: label of the screen's resolution and refresh rate -->
    <string name="catalyxx_about_display">Display</string>
    <!-- Specs card: label of the battery's capacity -->
    <string name="catalyxx_about_battery">Battery</string>
    <!-- Specs card: label of the cameras, e.g. "50 MP + 48 MP + 32 MP" -->
    <string name="catalyxx_about_camera">Camera</string>
    <!-- Specs card: label of the memory size and use -->
    <string name="catalyxx_about_ram">RAM</string>
    <!-- Specs card: label of the internal storage size and use -->
    <string name="catalyxx_about_storage">Storage</string>

    <!-- Screen resolution and fastest refresh rate, e.g. "1440 × 3216 · 120 Hz" -->
    <string name="catalyxx_about_display_value"><xliff:g id="width" example="1440">%1$d</xliff:g> × <xliff:g id="height" example="3216">%2$d</xliff:g> · <xliff:g id="refresh_rate" example="120">%3$d</xliff:g> Hz</string>
    <!-- Battery design capacity, e.g. "5000 mAh" -->
    <string name="catalyxx_about_battery_value"><xliff:g id="capacity" example="5000">%1$d</xliff:g> mAh</string>
    <!-- Memory size and how much of it is in use, e.g. "16 GB · 7.9 GB in use" -->
    <string name="catalyxx_about_ram_value"><xliff:g id="total" example="16 GB">%1$s</xliff:g> · <xliff:g id="used" example="7.9 GB">%2$s</xliff:g> in use</string>
    <!-- Internal storage in use and its size, e.g. "87 GB of 256 GB used" -->
    <string name="catalyxx_about_storage_value"><xliff:g id="used" example="87 GB">%1$s</xliff:g> of <xliff:g id="total" example="256 GB">%2$s</xliff:g> used</string>

    <!-- Build card: label of the person who builds Catalyxx for this device -->
    <string name="catalyxx_about_maintainer">Maintainer</string>

    <!-- Content description of the Catalyxx logo in the specs card; a tap opens Catalyxx Lab -->
    <string name="catalyxx_about_logo_description">Catalyxx Lab</string>
    <!-- Content description of the phone outline that shows the wallpaper -->
    <string name="catalyxx_about_wallpaper_description">Wallpaper</string>

    <!-- Toast after a long press on the homepage device card turns system blur back on -->
    <string name="catalyxx_homepage_blur_on">Blur effects on</string>
    <!-- Toast after a long press on the homepage device card turns system blur off -->
    <string name="catalyxx_homepage_blur_off">Blur effects off</string>

    <!-- Periodic Settings home (Catalyxx Lab > User interface > Settings home): the homepage
         as a periodic table. Each element holds a few homepage entries; its name is on its
         tile, its title on its page. -->
    <string name="periodic_cn_name">Connections</string>
    <string name="periodic_ps_name">Power</string>
    <string name="periodic_ps_title">Power &amp; storage</string>
    <string name="periodic_ls_name">Look &amp; sound</string>
    <string name="periodic_ap_name">Apps &amp; alerts</string>
    <string name="periodic_pr_name">Privacy</string>
    <string name="periodic_pr_title">Security &amp; privacy</string>
    <string name="periodic_sy_name">System</string>
    <string name="periodic_sy_title">System &amp; safety</string>
    <string name="periodic_ac_name">Accessibility</string>
    <string name="periodic_ex_name">Extras</string>

    <!-- Live value on Connections: Wi-Fi and Bluetooth are both on -->
    <string name="periodic_value_wifi_bt_on">Wi-Fi · BT on</string>
    <!-- Live value on Connections: only Wi-Fi is on -->
    <string name="periodic_value_wifi_on">Wi-Fi on</string>
    <!-- Live value on Connections: only Bluetooth is on -->
    <string name="periodic_value_bt_on">BT on</string>
    <!-- Live value on Connections: Wi-Fi and Bluetooth are both off -->
    <string name="periodic_value_connections_off">Wi-Fi · BT off</string>
    <!-- Live value on Power: battery level and free storage, e.g. "87% · 490 GB free" -->
    <string name="periodic_value_power"><xliff:g id="battery" example="87%">%1$s</xliff:g> · <xliff:g id="free" example="490 GB">%2$s</xliff:g> free</string>
    <!-- Live value on Look & sound while dark theme is on -->
    <string name="periodic_value_dark">Dark theme</string>
    <!-- Live value on Look & sound while dark theme is off -->
    <string name="periodic_value_light">Light theme</string>
    <!-- Live value on Apps & alerts while Do Not Disturb is on -->
    <string name="periodic_value_dnd_on">Do Not Disturb on</string>
    <!-- Live value on Apps & alerts while Do Not Disturb is off -->
    <string name="periodic_value_dnd_off">Do Not Disturb off</string>
    <!-- Live value on Privacy while location is on -->
    <string name="periodic_value_location_on">Location on</string>
    <!-- Live value on Privacy while location is off -->
    <string name="periodic_value_location_off">Location off</string>

    <!-- What TalkBack says for an element tile: its name, then its live value or what it holds -->
    <string name="periodic_element_description"><xliff:g id="name" example="Connections">%1$s</xliff:g>, <xliff:g id="details" example="Wi-Fi on">%2$s</xliff:g></string>
    <!-- What TalkBack says for the eclipse card: the phone's name, its version and battery level -->
    <string name="periodic_eclipse_description"><xliff:g id="device" example="OnePlus 11">%1$s</xliff:g>, <xliff:g id="version" example="Catalyxx 17.0 Chlorine">%2$s</xliff:g>, battery <xliff:g id="battery" example="87%">%3$s</xliff:g></string>
    <!-- What TalkBack adds to the eclipse card while the phone charges -->
    <string name="periodic_eclipse_charging">charging</string>
</resources>
